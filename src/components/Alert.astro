---
export enum AlertLevel {
  Info = "info",
  Success = "success",
  Warning = "warning",
  Error = "error",
}

interface Props {
  level: AlertLevel;
  class?: string;
}

const { level, class: className } = Astro.props;
---

<aside class:list={["alert", className]} data-level={level}>
  <slot />
</aside>

<style>
.alert {
  /* Default to the neutral palette; each level overrides the two aliases */
  --background-color: var(--color-alert-neutral-background);
  --border-color: var(--color-alert-neutral-border);
  background-color: var(--background-color);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  box-shadow: var(--shadow);

  /* Shrink to the content, but cap the line length */
  width: fit-content;
  max-width: 85ch;

  /* Center content and leave space inside the box */
  margin: 0 auto;
  padding: 1em;
}

/* Each level only sets the color variables the box applies */
.alert[data-level="info"] {
  --background-color: var(--color-alert-info-background);
  --border-color: var(--color-alert-info-border);
}
.alert[data-level="success"] {
  --background-color: var(--color-alert-success-background);
  --border-color: var(--color-alert-success-border);
}
.alert[data-level="warning"] {
  --background-color: var(--color-alert-warning-background);
  --border-color: var(--color-alert-warning-border);
}
.alert[data-level="error"] {
  --background-color: var(--color-alert-error-background);
  --border-color: var(--color-alert-error-border);
}

/* Each direct child will have the same margin inside the alert */
.alert > :global(*) {
  margin: 0 0 1rem;
}
.alert > :global(*:last-child) {
  margin-bottom: 0;
}
</style>
