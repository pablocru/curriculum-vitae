---
export enum AlertLevel {
  Info = "info",
  Success = "success",
  Warning = "warning",
  Error = "error",
}

interface Props {
  level: AlertLevel;
  class?: string;
}

const { level, class: className } = Astro.props;
---

<aside class:list={["alert", className]} data-level={level}>
  <slot />
</aside>

<style>
.alert {
  /* Rounded box; the level supplies the colors, with a neutral fallback */
  background-color: var(--background-color, rgba(0, 0, 0, 0.06));
  border: 1px solid var(--border-color, #999);
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);

  /* Shrink to the content, but cap the line length */
  width: fit-content;
  max-width: 85ch;

  /* Center content and leave space inside the box */
  margin: 0 auto;
  padding: 1em;
}

/* Each level only sets the color variables the box applies */
.alert[data-level="info"] {
  --background-color: rgba(0, 123, 255, 0.3);
  --border-color: #007bff;
}
.alert[data-level="success"] {
  --background-color: rgba(0, 255, 0, 0.3);
  --border-color: #28a745;
}
.alert[data-level="warning"] {
  --background-color: rgba(255, 255, 0, 0.3);
  --border-color: #ffcc00;
}
.alert[data-level="error"] {
  --background-color: rgba(255, 0, 0, 0.3);
  --border-color: #cc0000;
}

/* Each direct child will have the same margin inside the alert */
.alert > :global(*) {
  margin: 0 0 1rem;
}
.alert > :global(*:last-child) {
  margin-bottom: 0;
}
</style>
