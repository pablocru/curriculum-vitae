---
export enum AlertLevel {
  Info = "info",
  Success = "success",
  Warning = "warning",
  Error = "error",
}

interface Props {
  level: AlertLevel;
  class?: string;
}

const { level, class: className } = Astro.props;
---

<aside class:list={[`alert-${level}`, className]}>
  <slot />
</aside>

<style>
aside {
  /* Wrap content in a rounded box; colors come from the level class */
  background-color: var(--background-color);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);

  /* Shrink to the content, but cap the line length */
  width: fit-content;
  max-width: 85ch;

  /* Center content and leave space inside the box */
  margin: 0 auto;
  padding: 1em;
}

/* Each level only sets the color variables the box applies */
.alert-info {
  --background-color: rgba(0, 123, 255, 0.3);
  --border-color: #007bff;
}
.alert-success {
  --background-color: rgba(0, 255, 0, 0.3);
  --border-color: #28a745;
}
.alert-warning {
  --background-color: rgba(255, 255, 0, 0.3);
  --border-color: #ffcc00;
}
.alert-error {
  --background-color: rgba(255, 0, 0, 0.3);
  --border-color: #cc0000;
}

/* Each direct child will have the same margin inside the alert */
aside > :global(*) {
  margin: 0 0 1rem;
}
aside > :global(*:last-child) {
  margin-bottom: 0;
}
</style>
