---
export enum LinkButtonTheme {
  LinkedIn = "linkedIn",
  Default = "default",
}

interface Props {
  link: string;
  theme: LinkButtonTheme;
}

const { link, theme } = Astro.props;

// The LinkedIn theme is the only one with an icon
const iconClass =
  theme === LinkButtonTheme.LinkedIn ? "icon icon-linkedin" : undefined;
---

<!-- biome-ignore lint/a11y/useAnchorContent: content is provided via <slot /> -->
<a
  href={(URL.canParse(link) ? "" : import.meta.env.BASE_URL) + link}
  class:list={["link-button", iconClass]}
  data-theme={theme}
>
  <slot />
</a>

<style>
.link-button {
  /* Default theme colors; other themes override the two aliases */
  --background-color: var(--color-link-default-background);
  --foreground-color: var(--color-link-default-foreground);

  /* Keep the shape and avoid wrapping on small sizes */
  display: inline-block;
  background-color: var(--background-color);
  text-decoration: none;

  /* Button appearance */
  padding: 0.5em;
  border: 1px solid transparent;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

/* Keep the foreground color across every link state */
.link-button:any-link {
  color: var(--foreground-color);
}

.link-button[data-theme="linkedIn"] {
  --background-color: var(--color-link-linkedin-background);
  --foreground-color: var(--color-link-linkedin-foreground);
}
</style>
