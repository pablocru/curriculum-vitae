{
  "name": "curriculum-vitae",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type:check": "astro check",
    "quality:check:biome": "biome ci .",
    "quality:check:prettier": "prettier --check \"**/*.{yml,yaml}\"",
    "quality:check:rumdl": "rumdl check .",
    "quality:fix:biome": "biome check --write .",
    "quality:fix:prettier": "prettier --write \"**/*.{yml,yaml}\"",
    "quality:fix:rumdl": "rumdl fmt .",
    "quality:check": "pnpm run \"/^quality:check:/\" && pnpm type:check",
    "quality:fix": "pnpm run \"/^quality:fix:/\" && pnpm type:check"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "^5.18.2",
    "typescript": "5.6.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.1.17",
    "prettier": "3.9.9",
    "rumdl": "0.2.78"
  }
}
