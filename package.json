{
  "name": "curriculum-vitae",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type:check": "astro check",
    "quality:check:biome": "biome ci .",
    "quality:fix:biome": "biome check --write .",
    "quality:check": "pnpm run \"/^quality:check:/\" && pnpm type:check",
    "quality:fix": "pnpm run \"/^quality:fix:/\" && pnpm type:check"
  },
  "dependencies": {
    "@astrojs/check": "0.9.4",
    "astro": "4.16.18",
    "typescript": "5.6.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
